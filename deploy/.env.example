# Copy to deploy/.env and fill in. Never commit the real file.
POSTGRES_PASSWORD=change-me
SENTIENT_API_TOKEN=generate-with-openssl-rand-hex-32
SENTIENT_AUDIT_KEY=generate-with-openssl-rand-hex-32

# Storage tiers (absolute host paths).
# SSD: postgres, redis, data dir and vector index. HDD: raw document archive.
# WORKSPACE: the only directory tree the agent's file tools may touch.
SSD_PATH=/mnt/nvme/sentientai
HDD_PATH=/mnt/hdd/sentientai
WORKSPACE_PATH=/srv/sentientai/workspace

# GGUF models (host directory and file names). See docs/hardware.md for sizing.
MODELS_PATH=/mnt/nvme/models
HEAVY_MODEL=Qwen3-8B-Q5_K_M.gguf
FAST_MODEL=Qwen3-4B-Q4_K_M.gguf
EMBED_MODEL=nomic-embed-text-v1.5.Q8_0.gguf

# Context (tokens) the servers are started with and Fuzzy plans for. The 8B on the 2070 has room for 16k.
HEAVY_CTX_SIZE=16384
HEAVY_CTX=16384
FAST_CTX_SIZE=16384
FAST_CTX=8192          # per slot: two slots share FAST_CTX_SIZE

# Alternative: ONE bigger model across both cards (compose profile `bigmodel` instead of `models`).
# BIG_MODEL=mlabonne_Qwen3-14B-abliterated-Q4_K_M.gguf
# BIG_CTX_SIZE=32768
# HEAVY_URL=http://llm-big:8000/v1
# FAST_URL=http://llm-big:8000/v1
# HEAVY_CTX=16384
# FAST_CTX=16384

# Which GPU runs which tier: indices from `nvidia-smi -L` (they follow PCI order).
HEAVY_GPU=0    # RTX 2070
FAST_GPU=1     # GTX 1660 Ti

# The public site
# SITE_ADDRESS=fuzzy.example.org        # needed by `--profile web` (Caddy serves HTTPS)
# SENTIENT_COOKIE_SECURE=true           # false only for plain-http testing
# SENTIENT_REGISTRATION=invite          # invite | open | closed
# SENTIENT_IMAGE_BACKEND=disabled       # disabled | automatic1111 | openai (see docs/hardware.md)
# SENTIENT_IMAGE_URL=http://host.docker.internal:7860

# Numeric ids (group names may not exist inside the images):
#   id -u sentient; id -g sentient; getent group docker | cut -d: -f3
SENTIENT_UID=1000
SENTIENT_GID=1000
DOCKER_GID=999
